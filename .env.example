NODE_ENV=development

# Mode gating
APP_MODE=paper
LIVE_MODE=false
KILL_SWITCH_ON=false

# Service ports
MARKET_WATCHER_PORT=3001
TRADER_PORT=3002
RECONCILER_PORT=3003

# Risk defaults
MAX_MARKET_DATA_AGE_SEC=60
DAILY_LOSS_LIMIT_USD=100
MAX_ORDER_NOTIONAL_USD=100

# Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=auto_trader
MYSQL_USER=auto_trader
MYSQL_PASSWORD=auto_trader_dev

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
TRADE_SIGNAL_QUEUE_NAME=tradeSignalQueue
RECOMMENDATION_QUEUE_NAME=recommendationQueue
RECOMMENDATION_STORE_KEY=recommendationHistory
RECOMMENDATION_STORE_MAX_ITEMS=2000
RECOMMENDATION_SHORTLIST_SCAN_SIZE=300
RECOMMENDATION_SHORTLIST_DEFAULT_LIMIT=10
RECOMMENDATION_SHORTLIST_DEFAULT_LOOKBACK_MIN=360
RECOMMENDATION_SHORTLIST_DEFAULT_MIN_SCORE=65
ORDER_INTENT_QUEUE_NAME=orderIntentQueue

# Market watcher
MARKET_UNIVERSE=SOXL,TQQQ
TRIGGER_COOLDOWN_SEC=300
STALENESS_CHECK_INTERVAL_SEC=15

# Analyst worker
ANALYST_LLM_MODEL=gpt-4o-mini
ANALYST_LLM_TIMEOUT_MS=1500
ANALYST_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
ANALYST_WORKER_CONCURRENCY=2
ANALYST_EMIT_ORDER_INTENT=false
ANALYST_SCORE_BUY_THRESHOLD=65
ANALYST_NEWS_LOOKBACK_MIN=180
ANALYST_NEWS_MAX_ITEMS=20
ANALYST_NEWS_MOCK_ITEMS_JSON=[]
ANALYST_AVAILABLE_CASH_USD=100000
ANALYST_ORDER_NOTIONAL_USD=100
ANALYST_DAILY_PNL_USD=0

# Trader worker
TRADER_WORKER_CONCURRENCY=2
TRADER_AVAILABLE_CASH_USD=100000
TRADER_DAILY_PNL_USD=0
TRADER_LIVE_ORDER_ENABLED=false

# KIS / LLM credentials (set locally only)
KIS_TOKEN_URL=https://openapi.koreainvestment.com:9443/oauth2/tokenP
KIS_APPROVAL_URL=https://openapi.koreainvestment.com:9443/oauth2/Approval
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_REQUEST_TIMEOUT_MS=5000
KIS_AUTH_MAX_RETRY_COUNT=2
KIS_AUTH_RETRY_BACKOFF_MS=300
KIS_AUTH_EXPIRY_SKEW_SEC=30
KIS_WS_ENABLED=false
KIS_WS_URL=wss://openapi.koreainvestment.com:9443/ws
KIS_WS_APPROVAL_KEY=
KIS_WS_CUSTOMER_TYPE=P
KIS_WS_TR_ID=HDFSCNT0
KIS_WS_RECONNECT_BASE_MS=1000
KIS_WS_RECONNECT_MAX_MS=10000
OPENAI_API_KEY=
