{
  "name": "auto-trader",
  "version": "0.1.0",
  "private": true,
  "description": "KIS US stock auto-trader (safety-first)",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "infra:up": "docker compose up -d mysql redis",
    "infra:down": "docker compose down",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:watcher": "tsx watch --env-file-if-exists=.env apps/market-watcher/src/main.ts",
    "dev:analyst": "tsx watch --env-file-if-exists=.env apps/analyst-worker/src/main.ts",
    "dev:trader": "tsx watch --env-file-if-exists=.env apps/trader/src/main.ts",
    "dev:reconciler": "tsx watch --env-file-if-exists=.env apps/reconciler/src/main.ts",
    "start:watcher": "node --env-file-if-exists=.env dist/apps/market-watcher/src/main.js",
    "start:analyst": "node --env-file-if-exists=.env dist/apps/analyst-worker/src/main.js",
    "start:trader": "node --env-file-if-exists=.env dist/apps/trader/src/main.js",
    "start:reconciler": "node --env-file-if-exists=.env dist/apps/reconciler/src/main.js",
    "demo:enqueue-signal": "tsx --env-file-if-exists=.env scripts/enqueue-demo-signal.ts",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.3",
    "@nestjs/core": "^11.0.3",
    "@nestjs/platform-express": "^11.0.3",
    "bullmq": "^5.56.8",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "mysql2": "^3.11.5",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
